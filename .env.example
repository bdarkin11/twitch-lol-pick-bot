# Copiar como ".env" y completar. El .env real no se sube al repo.

# Usuario de la cuenta de Twitch que usa el bot
TWITCH_USERNAME=
# Token OAuth del bot, con el formato oauth:xxxxxxxx
TWITCH_OAUTH=
# Canal donde el bot escribe
TWITCH_CHANNEL=

# Key del Riot Developer Portal
RIOT_API_KEY=
# Riot ID con el formato Nombre#TAG
RIOT_SUMMONER_NAME=

# Opcionales
# RIOT_REGION=la2
# RIOT_ROUTING=americas
